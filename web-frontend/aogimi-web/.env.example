# web-frontend/aogimi-web/.env — the only variable this package reads.
# Copy to .env and fill in.

# Backend origin. Must be listed in the backend's CORS_ORIGIN, and calls use
# credentials:'include' so the httpOnly refresh cookie reaches /api/auth.
# Defaults to http://localhost:3000 when unset. lib/api.ts
NEXT_PUBLIC_API_URL=http://localhost:3000
