# backend/.env — every variable the backend reads.
# Copy to .env and fill in. Loaded by dotenv in server.js.

# ── Required ────────────────────────────────────────────────────────────────

# Postgres connection string. Any non-localhost URL connects over TLS with
# rejectUnauthorized:false (managed Postgres self-signed certs); localhost and
# 127.0.0.1 connect in plaintext. src/db.js
DATABASE_URL=postgresql://postgres:postgres@localhost:5432/aogimi

# HS256 signing keys, one each. Both must be >= 32 chars or the server throws
# on boot — there is no safe default for a signing key. Separate keys so a leak
# of one does not compromise both. src/config/auth.js
#   node -e "console.log(require('crypto').randomBytes(64).toString('hex'))"
JWT_ACCESS_SECRET=
JWT_REFRESH_SECRET=

# ── Optional, with defaults ─────────────────────────────────────────────────

# Listen port. server.js
PORT=3000

# 'production' enables the x-forwarded-proto HTTPS redirect and flips
# COOKIE_SECURE on by default. src/app.js, src/config/auth.js
NODE_ENV=development

# Comma-separated allowlist of web origins. Origin-less requests (native app,
# curl) always pass; everything else must be listed. Also reused as the CSRF
# allowlist on POST /api/auth/refresh. src/app.js
CORS_ORIGIN=http://localhost:3001,http://localhost:3002

# Token lifetimes, as jsonwebtoken duration strings. Note REFRESH_TTL_MS in
# src/config/auth.js is a hardcoded 30 days used for the DB expires_at row and
# the cookie Max-Age — change JWT_REFRESH_EXPIRY and that constant together.
JWT_ACCESS_EXPIRY=15m
JWT_REFRESH_EXPIRY=30d

# ── Refresh cookie (web transport only) ─────────────────────────────────────
# The cookie is named aogimi_refresh, is httpOnly, and is scoped to /api/auth.
# Those three are constants, not env vars.
#
# Defaults assume same-site deployment (web at the apex, API at api.<domain>),
# which makes Lax sufficient and lets the cookie stay host-only. If the API
# moves to a different registrable domain, set COOKIE_SAMESITE=none — that
# forces Secure on automatically. src/config/auth.js
COOKIE_SAMESITE=lax
# Defaults to true when NODE_ENV=production, false otherwise.
# COOKIE_SECURE=true
# Leave unset to keep the cookie host-only (recommended).
# COOKIE_DOMAIN=

