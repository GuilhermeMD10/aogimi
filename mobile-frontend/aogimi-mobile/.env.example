# mobile-frontend/aogimi-mobile/.env — the only variable this package reads.
# Copy to .env and fill in.

# Backend origin, as reachable from the simulator or device. A physical device
# cannot reach `localhost` — use the host machine's LAN address. Native fetch
# sends no Origin header, so CORS does not apply and the refresh token comes
# back in the response body (stored in expo-secure-store).
EXPO_PUBLIC_API_URL=http://localhost:3000
