# React Native 0.83 ships with react-native-reanimated 4.x, but several
# community libs (react-native-awesome-gallery@0.4.3, etc.) still declare
# their peer range as ^3. They work fine on 4 in practice — upstream just
# hasn't bumped the peer hint. Setting legacy-peer-deps here makes every
# `npm install` in this package skip the peer check, so the install
# doesn't require an explicit `--legacy-peer-deps` flag each time.
legacy-peer-deps=true
