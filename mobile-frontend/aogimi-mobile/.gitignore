# ── Native build outputs (expo run:ios / expo run:android) ───────────────────
# Everything below is regenerated every time you build for a real device or
# simulator. None of it belongs in git. The per-folder ios/.gitignore and
# android/.gitignore already cover most of this; the duplication here keeps
# rules discoverable at the project root.

# iOS — Xcode + CocoaPods
ios/build/
ios/DerivedData/
ios/Pods/
ios/**/xcuserdata/
ios/**/*.xcuserstate
ios/**/project.xcworkspace/
ios/.xcode.env.local
*.ipa
*.xcarchive
*.dSYM.zip

# Android — Gradle + IntelliJ
android/build/
android/.gradle/
android/app/build/
android/.cxx/
android/.kotlin/
android/.idea/
android/local.properties
android/captures/
android/**/*.iml
*.hprof
*.apk
*.aab
*.keystore

# Expo build / EAS
.expo-shared/
eas-build-*
.eas
ios-build/
android-build/

# Dictionary build artifacts. The .gz variant is kept out — we ship
# uncompressed. The .sqlite IS intentionally tracked (or untracked but
# present at build time) because EAS Build needs it to bundle into the
# APK; .easignore alone wasn't reliably overriding .gitignore in the
# upload step. To keep it out of git but still have it on disk, use:
#   git update-index --skip-worktree mobile-frontend/aogimi-mobile/assets/dictionary.sqlite
# after committing it once — that holds the committed version while
# letting you regenerate the file locally without pollution noise.
assets/dictionary.sqlite.gz

assets/dictionary.sqlite